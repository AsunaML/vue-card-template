{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist/scripts",
    "rootDir": "./tavern-script",
    "declaration": false,
    "sourceMap": false,
    "removeComments": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    
    // 浏览器环境类型支持
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "tavern-script/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src"
  ]
}