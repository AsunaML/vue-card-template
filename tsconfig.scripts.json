{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "outDir": "./dist/scripts",
    "declaration": false,
    "sourceMap": false,
    "removeComments": true,
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": false,
    "allowJs": true,
    "isolatedModules": false,
    
    // 浏览器环境类型支持
    "lib": ["ES2020", "DOM"],
    
    // 全局类型支持（仅限 tavern-script 环境）
    "types": ["jquery"]
  },
  "include": [
    "tavern-script/**/*",
    "communication/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src"
  ]
}